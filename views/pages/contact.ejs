<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header.ejs') %>
</head>
<body>
    <%- include('../partials/menu.ejs') %>

    <div class="container my-5">
        <div class="row g-5">
            <div class="col-md-5">
                <h2 class="fw-bold">Get In Touch</h2>
                <p class="text-muted">Have a question about game stock, trade-ins, or tournament signups?</p>
                <hr>
                <p><strong>Address:</strong> 100 Monument Circle, Indianapolis, IN 46204</p>
                <p><strong>Phone:</strong> (317) 067-6767</p>
                <p><strong>Email:</strong> support@indygamevault.com</p>
                <p><strong>Hours:</strong> Mon - Sat: 10 AM - 10 PM | Sun: 12 PM - 8 PM</p>
            </div>

            <div class="col-md-7">
                <div class="card p-4 shadow-sm border-0">
                    <h3 class="mb-3">Send Us a Message</h3>
                    <form>
                        <div class="mb-3">
                            <label for="name" class="form-label">Full Name</label>
                            <input type="text" class="form-control" id="name" placeholder="John Doe" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <input type="email" class="form-control" id="email" placeholder="name@example.com" required>
                        </div>
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control" id="message" rows="4" placeholder="Ask about product availability..." required></textarea>
                        </div>
                        <button type="button" class="btn btn-primary btn-lg w-100">Submit Inquiry</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
