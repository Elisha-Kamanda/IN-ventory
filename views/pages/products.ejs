<!DOCTYPE html>
<html lang="en">
    <head>
        <%- include('../partials/header.ejs') %>
    </head>
    <body>
        <%- include('../partials/menu.ejs') %>

        <div class="container my-4">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                <% if (inventory && inventory.length > 0) { %>
                    <% inventory.forEach(item => { %>
                        <div class="col">
                            <div class="card h-100">
                                <img src="<%=item.image_url%>" class="card-img-top" alt="<%item.name%>">
                                <div class="card-body">
                                    <h5 class="card-title"><%= item.name %></h5>
                                    <p class="fw-bold">$<%= item.cost %></p>
                    
                                  
                                    <button type="button" class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#modal-<%= item.id %>">
                                        View Details
                                    </button>
                                </div>
                            </div>
                        </div>
                    
                    
                        <div class="modal fade" id="modal-<%= item.id %>" tabindex="-1" aria-labelledby="modalLabel-<%= item.id %>" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="modalLabel-<%= item.id %>"><%= item.name %> Details</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-dark">
                                        <p><strong>Genre:</strong> <%= item.genre %></p>
                                        <p><strong>Price:</strong> $<%= item.cost %></p>
                                        <p><strong>Stock Available:</strong> <%= item.stock %></p>
                                        <p><strong>Rating:</strong> <%= item.rating %> / 5</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No products found in inventory.</p>
                <% } %>
            </div>
        </div>
        <%- include('../partials/footer.ejs') %>
    </body>
</html>