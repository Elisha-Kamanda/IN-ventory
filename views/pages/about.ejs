<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/header.ejs') %>
</head>
<body>
    <%- include('../partials/menu.ejs') %>

    <div class="container my-5">
        <div class="row align-items-center mb-5">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold text-primary">About Indy Game Vault</h1>
                <p class="lead text-secondary">Indiana's premier prototype video game store and esports lounge.</p>
                <p>Founded in central Indiana, Indy Game Vault was built to bring gamers, retro collectors, and local esports enthusiasts together under one roof. Whether you are looking for physical releases of the latest blockbusters or classic arcade hits, our inventory caters to every type of gamer.</p>
            </div>
            <div class="col-md-6">
                <div class="p-5 bg-dark text-white rounded-3 text-center">
                    <h3> Hoosier Gaming Hub</h3>
                    <p class="mb-0">Locally owned and operated in the heart of Indiana.</p>
                </div>
            </div>
        </div>

        <div class="row text-center g-4">
            <div class="col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm">
                    <h4> Massive Inventory</h4>
                    <p class="text-muted">Over 10 physical titles tracked live through our SQLite database framework.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm">
                    <h4> Local Tournaments</h4>
                    <p class="text-muted">Weekly Midwest racing and fighting game bracket competitions.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4 border-0 shadow-sm">
                    <h4> Trusted Ratings</h4>
                    <p class="text-muted">Community-driven product reviews and transparent stock tracking.</p>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html> 
